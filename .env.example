# Copy to .env (done automatically by the dev container). Never commit .env.
# LLM settings for explain-api (LN-8). Provider is still an open question in the spec.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Local stack started by `make up` (deploy/compose/compose.yaml). Local-only defaults, not secrets.
DATABASE_URL=postgres://linked_numbers:linked_numbers@localhost:5432/linked_numbers?sslmode=disable
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
