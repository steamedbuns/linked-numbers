#!/usr/bin/env bash
# Terminal entry point to the Linked Numbers dev container.
#
#   ./dev [shell]      open a bash shell in this checkout's dev container
#   ./dev run CMD...   run one command in this checkout's dev container
#   ./dev rebuild      rebuild the image and recreate this checkout's container
#   ./dev down         remove this checkout's container and image (caches kept)
#   ./dev ps           list dev containers for all checkouts/worktrees
#   ./dev nuke         remove all dev containers, images and cache volumes
#
# Containers are created by the devcontainer CLI from
# .devcontainer/devcontainer.json -- the same config VS Code uses, and ./dev
# reuses any container VS Code created. So "Reopen in Container" and ./dev share one
# container per checkout (named linked-numbers-dev-<folder name>), whichever
# of them starts it first. Each git worktree gets its own container.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Image that only runs the devcontainer CLI; built from the same Dockerfile,
# so it shares every layer with the dev image.
TOOLS_IMAGE="linked-numbers-dev-tools:$(cat "$ROOT"/.devcontainer/* | sha256sum | cut -c1-16)"
VOLUMES=(ln-gomod ln-gocache ln-pub ln-npm ln-playwright)

die() { echo "dev: $*" >&2; exit 1; }
docker info >/dev/null 2>&1 || die "docker is not reachable; run scripts/host/install-docker-wsl.sh first"

# The container for this checkout. It is looked up by our own ln.dev-root label
# (set in devcontainer.json runArgs), not devcontainer.local_folder: VS Code
# opened from a Windows window sets local_folder to a \\wsl.localhost\... path,
# while ln.dev-root always holds the Linux path.
container() {
  docker ps -aq --filter "label=ln.dev-root=$ROOT" | head -n1
}

running() { [[ "$(docker container inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" == true ]]; }

devcontainer_cli() {
  if ! docker image inspect "$TOOLS_IMAGE" >/dev/null 2>&1; then
    echo "dev: building image (first run or .devcontainer/ changed)..." >&2
    docker build --label ln.dev-image=1 -t "$TOOLS_IMAGE" "$ROOT/.devcontainer" >&2
    docker image ls linked-numbers-dev-tools --format '{{.Repository}}:{{.Tag}}' \
      | grep -vx "$TOOLS_IMAGE" | xargs -r docker image rm >/dev/null 2>&1 || true
  fi
  # Run as the host user with the host's HOME path, so ${localEnv:HOME} and
  # the UID check in devcontainer.json resolve exactly as they do for VS Code.
  docker run --rm --network=host \
    --user "$(id -u):$(id -g)" --group-add "$(stat -c %g /var/run/docker.sock)" \
    --entrypoint devcontainer \
    -e HOME="$HOME" --tmpfs "$HOME:uid=$(id -u),gid=$(id -g)" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$ROOT:$ROOT" -w "$ROOT" \
    "$TOOLS_IMAGE" "$@"
}

up() {
  # Serialize start-up so parallel `./dev run` calls don't race to create it.
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ln-dev-$(printf %s "$ROOT" | sha256sum | cut -c1-8).lock"
  flock 9

  local cid
  cid="$(container)"
  if [[ -n "$cid" ]] && ! running "$cid"; then
    # Start it directly: `devcontainer up` finds containers by local_folder, so
    # it misses one VS Code created from Windows and tries to create a second.
    # Post-create already ran when the container was created.
    docker start "$cid" >/dev/null || die "could not start dev container $cid"
  elif [[ -z "$cid" ]]; then
    mkdir -p "$HOME/.config/gh"
    # In a worktree, .git points into the main repo's git dir; mount it at the
    # same path so git (and `go build` VCS stamping) works in the container.
    local extra=() git_common
    git_common="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    if [[ -n "$git_common" && "$git_common" != "$ROOT"/* ]]; then
      extra+=(--mount "type=bind,source=$git_common,target=$git_common")
    fi
    # Create the container and run lifecycle hooks (post-create).
    devcontainer_cli up --workspace-folder "$ROOT" "${extra[@]}" >&2 \
      || die "devcontainer up failed (a container named linked-numbers-dev-${ROOT##*/} from another path? see ./dev ps)"
    cid="$(container)"
  fi
  [[ -n "$cid" ]] || die "dev container did not start"

  local newest created
  newest="$(stat -c %Y "$ROOT"/.devcontainer/* | sort -n | tail -n1)"
  created="$(date -d "$(docker container inspect -f '{{.Created}}' "$cid")" +%s)"
  (( newest > created )) && echo "dev: .devcontainer/ changed since this container was created; run ./dev rebuild (or Rebuild Container in VS Code)" >&2

  flock -u 9
  CID="$cid"
}

in_container() {
  local tty=()
  [[ -t 0 && -t 1 ]] && tty=(-it)
  # Keep the caller's working directory when it is inside this checkout.
  local wd="$ROOT"
  [[ "$PWD" == "$ROOT" || "$PWD" == "$ROOT"/* ]] && wd="$PWD"
  docker exec "${tty[@]}" -u vscode -w "$wd" "$CID" "$@"
}

# Removes this checkout's container and its per-checkout image (layers are
# shared, so recreating it later is fast). The image is kept while any other
# container still uses it: with the containerd image store, `docker image rm`
# deletes an image even when a running container depends on it.
remove_container() {
  local cid image
  cid="$(container)"
  [[ -n "$cid" ]] || return 0
  image="$(docker container inspect -f '{{.Config.Image}}' "$cid")"
  docker rm -f "$cid" >/dev/null
  [[ -z "$(docker ps -aq --filter "ancestor=$image")" ]] || return 0
  docker image rm "$image" "${image%-uid}" >/dev/null 2>&1 || true
}

cmd="${1:-shell}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  shell)   up; in_container bash ;;
  run)     [[ $# -gt 0 ]] || die "usage: ./dev run CMD..."; up; in_container "$@" ;;
  rebuild) remove_container; up ;;
  down)    remove_container ;;
  ps)      docker ps -a --filter label=ln.dev-root --format 'table {{.Names}}\t{{.Status}}\t{{.Label "ln.dev-root"}}' ;;
  nuke)
    docker ps -aq --filter label=ln.dev-root | xargs -r docker rm -f >/dev/null
    docker image ls -q --filter label=ln.dev-image=1 | sort -u | xargs -r docker image rm -f >/dev/null
    docker volume rm "${VOLUMES[@]}" >/dev/null 2>&1 || true
    echo "dev: removed all dev containers, images and cache volumes"
    ;;
  -h|--help|help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$cmd' (try ./dev help)" ;;
esac
